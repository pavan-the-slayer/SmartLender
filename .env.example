# Copy to .env and fill in for local development
PREDICT_API_KEY=dev-local-key-123

# Only needed if predict_api should pull the key from AWS Secrets Manager
# instead of the PREDICT_API_KEY above:
# AWS_SECRET_NAME=smartlender/predict-api-key
# AWS_REGION=us-east-1

# webapp: where to send /predict requests (docker-compose sets this to
# http://predict-api:5000/predict automatically)
PREDICT_URL=http://localhost:5000/predict
