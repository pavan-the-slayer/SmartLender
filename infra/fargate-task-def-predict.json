{
  "family": "smartlender-predict-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/smartlenderPredictApiTaskRole",
  "containerDefinitions": [
    {
      "name": "predict-api",
      "image": "<dockerhub-user>/smartlender-predict-api:latest",
      "portMappings": [{ "containerPort": 5000, "protocol": "tcp" }],
      "environment": [
        { "name": "AWS_SECRET_NAME", "value": "smartlender/predict-api-key" },
        { "name": "AWS_REGION", "value": "<REGION>" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:5000/health')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smartlender-predict-api",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "predict-api"
        }
      }
    }
  ]
}
